# Salin file ini jadi .env lalu isi dari Neon Console (tombol "Connect").
# JANGAN commit file .env ke GitHub.

# Pooled connection (hostname ada "-pooler") -> dipakai aplikasi lewat @prisma/adapter-neon
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct connection (tanpa "-pooler") -> dipakai Prisma CLI (migrate, studio)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

PORT=3000
